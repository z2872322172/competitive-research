# APP_ENV accepts dev, test, or prod.
# dev: SQLite + inline workflow
# test: isolated SQLite/Redis DB numbers for automated tests
# prod: MySQL + Redis + Celery defaults for Docker/deploy-style runs
#
# ⚠️ SQLite 仅用于本地开发/离线演示：本地 verda_dev.db 不是生产事实库，
#    生产环境必须使用 MySQL（Docker Compose 已内置），数据以 MySQL 为唯一事实源，
#    ES 索引与对象存储快照均可从 MySQL 重建。
APP_ENV=dev
ENVIRONMENT=dev
DATABASE_URL=sqlite:///./verda_dev.db

# MySQL connection can be provided as a full DATABASE_URL, or composed from MYSQL_*.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=verda
MYSQL_PASSWORD=verda
MYSQL_DATABASE=verda

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_RESULT_DB=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
TASK_MODE=inline

ELASTICSEARCH_URL=http://localhost:9200

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=verda-artifacts
MINIO_SECURE=false

SEARCH_PROVIDER=tavily
SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=
FETCH_TIMEOUT_SECONDS=12
FETCH_MAX_RETRIES=2
FETCH_RETRY_BACKOFF_SECONDS=0.5
FETCH_RATE_LIMIT_SECONDS=1
FETCH_MAX_BYTES=1500000
FETCH_RESPECT_ROBOTS=true
PARSER_PREFER_TRAFILATURA=true
MIN_SOURCE_TEXT_CHARS=400
ARTIFACT_STORAGE_DIR=storage

LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=chat-latest
LLM_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_EVIDENCE_ITEMS=8
